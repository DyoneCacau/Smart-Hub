# ============================================================
# EXEMPLO DE CONFIGURACAO - copie para .env e preencha
# ============================================================
# Producao: configure no painel da hospedagem (Vercel/Netlify)

# Obrigatorias (frontend)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alias opcional da chave anon
# VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Suporte — telas de clínica pendente / acesso suspenso / billing
VITE_SUPPORT_EMAIL=suporte@healthcare.com.br
VITE_SUPPORT_WHATSAPP=5511999999999

# Edge Function Secrets (Supabase Dashboard — nao use prefixo VITE_)
# SUPABASE_SERVICE_ROLE_KEY=...
# CRON_SECRET=...
# INIT_SECRET=...
# APP_URL=https://seu-dominio.com.br

# Asaas (somente Supabase Edge Function Secrets; nunca exponha no frontend)
# Desenvolvimento/homologacao:
# ASAAS_ENV=sandbox
# ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=configure_diretamente_no_painel_supabase
# ASAAS_WEBHOOK_TOKEN=gere_um_token_aleatorio_de_32_a_255_caracteres
# Producao usa ASAAS_ENV=production e https://api.asaas.com/v3.
# Nunca reutilize chaves entre Sandbox e Producao.

# Meta — OAuth + webhooks (secrets no Supabase, NUNCA no frontend / VITE_)
# META_APP_ID=id_do_app_no_meta_developers
# META_APP_SECRET=obrigatorio_para_oauth_hmac_e_leadgen
# META_OAUTH_REDIRECT_URI=https://SEU-PROJETO.supabase.co/functions/v1/meta-oauth/callback
# META_WEBHOOK_VERIFY_TOKEN=desafio_GET_meta-leadgen-webhook_e_meta-webhook_whatsapp
# Cadastre a redirect URI no Meta Developers > Facebook Login.
# Webhook Lead Ads (Page → leadgen): .../functions/v1/meta-leadgen-webhook
