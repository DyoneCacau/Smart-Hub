# ============================================================
# FUNNEL PLATFORM / SMART HUB — configuracao standalone
# Copie para .env.local no desenvolvimento.
# Em producao, configure no painel da hospedagem (Vercel/Netlify).
# Nunca commite chaves secretas.
# ============================================================

# Obrigatorias no frontend
VITE_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Compatibilidade com projetos Supabase que ainda usam anon JWT
# Use apenas UMA das duas chaves abaixo; publishable e a preferida.
# VITE_SUPABASE_ANON_KEY=eyJ...

# URL publica da aplicacao (opcional; util para links, redirects e Edge Functions)
# VITE_APP_URL=https://seu-dominio.com.br

# ============================================================
# EDGE FUNCTIONS / SERVIDOR — NUNCA usar prefixo VITE_
# Configure diretamente em Supabase > Edge Functions > Secrets.
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=configure_no_painel_e_nunca_no_git
# APP_URL=https://seu-dominio.com.br

# Integracoes futuras
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=https://SEU-PROJECT-REF.supabase.co/functions/v1/meta-oauth/callback
# META_WEBHOOK_VERIFY_TOKEN=

# Seguranca:
# - publishable/anon pode ser usado no frontend sob RLS.
# - service_role ignora RLS e deve permanecer exclusivamente no backend/Edge Functions.
